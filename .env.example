# CarePilot AI — Backend Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit the actual .env files — they are git-ignored.

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carepilot_db
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# ─── Synthea Data Generation ──────────────────────────────────────────────────
SYNTHEA_SEED=42
SYNTHEA_PATIENT_COUNT=2000
SYNTHEA_STATE=Massachusetts

# ─── Knowledge Base Configuration ────────────────────────────────────────────
KB_SNAPSHOT_ID=v5
CHROMA_COLLECTION=carepilot_kb_v5
BM25_INDEX_PATH=./rag_knowledge/bm25_index_v5.pkl
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LANGUAGE_DEFAULT=en

# ─── LLM Configuration (Pillar B) ────────────────────────────────────────────
# Local LLM (Qwen via Ollama)
LLM_LOCAL_MODEL_PATH=./models/qwen-4b-q4.gguf
LLM_LOCAL_N_GPU_LAYERS=20
LLM_LOCAL_MAX_TOKENS=1024

# Optional cloud fallback. Do not enable this for PHI without an appropriate agreement.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_URL=https://integrate.api.nvidia.com/v1/chat/completions

# ─── Pipeline Configuration ───────────────────────────────────────────────────
KB_DENSE_TOP_K=15
KB_BM25_TOP_K=15
KB_RRF_K=60
KB_FINAL_TOP_N=8
EHR_RETRIEVAL_K=5

# ─── Validation Thresholds ────────────────────────────────────────────────────
FAITHFULNESS_THRESHOLD=0.80
NLI_ENTAILMENT_THRESHOLD=0.40

# ─── API Server ───────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
