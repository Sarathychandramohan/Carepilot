# CarePilot AI Backend — Environment Variables Template
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=carepilot_db
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# ─── Synthea Data Generation ──────────────────────────────────────────────────
SYNTHEA_SEED=42
SYNTHEA_PATIENT_COUNT=2000
SYNTHEA_STATE=Massachusetts

# ─── Knowledge Base Configuration ────────────────────────────────────────────
KB_SNAPSHOT_ID=v5
CHROMA_COLLECTION=carepilot_kb_v5
BM25_INDEX_PATH=D:/CarePilotAI/rag_knowledge/bm25_index_v5.pkl
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ─── LLM Configuration (Pillar B) ────────────────────────────────────────────
LLM_LOCAL_MODEL_PATH=D:/CarePilotAI/models/qwen-4b-q4.gguf
LLM_LOCAL_N_GPU_LAYERS=20
LLM_LOCAL_MAX_TOKENS=1024

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# ─── Pipeline Configuration ───────────────────────────────────────────────────
KB_DENSE_TOP_K=15
KB_BM25_TOP_K=15
KB_RRF_K=60
KB_FINAL_TOP_N=8
EHR_RETRIEVAL_K=5

# ─── Validation Thresholds ────────────────────────────────────────────────────
FAITHFULNESS_THRESHOLD=0.80
NLI_ENTAILMENT_THRESHOLD=0.40

# ─── API Server ───────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
